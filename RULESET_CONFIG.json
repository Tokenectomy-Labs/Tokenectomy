{
  "rulesets": [
    {
      "name": "Master Branch Protection",
      "description": "Production-grade protection for master branch with GitHub Actions CI/CD",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "include": ["master"],
          "exclude": []
        }
      },
      "rules": {
        "creation": true,
        "update": true,
        "deletion": true,
        "required_linear_history": true,
        "required_deployments_to_succeed": false,
        "required_signatures": true,
        "pull_request_required": {
          "dismiss_stale_reviews": true,
          "require_code_owner_review": false,
          "require_last_push_approval": false,
          "required_approving_review_count": 1
        },
        "required_status_checks": [
          "build",
          "test",
          "lint"
        ],
        "restrict_force_pushes": true
      }
    },
    {
      "name": "Release Branch Protection",
      "description": "Production-grade protection for release branches with GitHub Actions CI/CD",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "include": ["release/*"],
          "exclude": []
        }
      },
      "rules": {
        "creation": true,
        "update": true,
        "deletion": true,
        "required_linear_history": true,
        "required_deployments_to_succeed": false,
        "required_signatures": true,
        "pull_request_required": {
          "dismiss_stale_reviews": true,
          "require_code_owner_review": false,
          "require_last_push_approval": false,
          "required_approving_review_count": 1
        },
        "required_status_checks": [
          "build",
          "test",
          "lint"
        ],
        "restrict_force_pushes": true
      }
    }
  ],
  "notes": {
    "github_actions_setup": "Status checks assume you have GitHub Actions workflows named: build, test, lint",
    "customize": "Update 'required_status_checks' array dengan nama workflow/job Anda yang sebenarnya"
  }
}
